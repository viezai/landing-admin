# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (SQLite file path)
DB_PATH=./data/contacts.db

# Security & Admin Authentication
# Used to authenticate to the Admin Dashboard (passkey / login)
ADMIN_SECRET_KEY=viezai_admin_secret_2026
JWT_SECRET=viezai_jwt_super_secret_signing_key_2026

# CORS Allowed Origins (Comma separated or * in dev)
CORS_ORIGINS=https://viezai.com,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Anti-Spam & Rate Limiting
# Max submissions allowed per IP within the window (in ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Optional Instant Notification Webhooks (Plug-and-play)
# Telegram Bot:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook URL:
DISCORD_WEBHOOK_URL=

# Slack Incoming Webhook URL:
SLACK_WEBHOOK_URL=

# Generic HTTP Webhook (POST JSON):
CUSTOM_WEBHOOK_URL=
